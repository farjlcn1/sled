# Kopiraj to datoteko v .env (lokalni razvoj + docker-compose) in v .env.production
# (spremenljivke, ki jih potrebuje app vsebnik v produkciji) — glej README.md za razlago.

# --- Postgres / docker-compose ---
# Uporablja se SAMO v docker-compose.yml (za ${POSTGRES_PASSWORD} substitucijo) — docker
# compose samodejno prebere .env v istem imeniku. Izogibaj se znakom @ : / # % (znašejo se
# neposredno v connection string brez URL-encodinga).
POSTGRES_PASSWORD=

# --- Baza podatkov ---
# Berejo neposredno lib/db.ts, prisma/seed*.ts in prisma.config.ts (ne samo Prisma CLI).
# V .env (lokalni razvoj): kaže na lokalno dev bazo (glej README, korak "Lokalni razvoj").
# V produkciji NI potrebno — docker-compose.yml jo sam sestavi iz POSTGRES_PASSWORD in vstavi
# v app vsebnik (glej "environment: DATABASE_URL" v docker-compose.yml).
DATABASE_URL=postgresql://sledenje:devpass@localhost:5433/sledenje

# --- Seje / avtentikacija ---
# Poljuben dolg naključen niz za podpisovanje JWT piškotka seje (lib/auth/session.ts, proxy.ts).
# Generiraj npr.: openssl rand -base64 32
SESSION_SECRET=

# --- Traccar (GPS/AVL strežnik) ---
# lib/traccar.ts. TRACCAR_API_URL: lokalno http://localhost:8082, v produkciji
# http://traccar:8082 (ime docker-compose storitve, notranje omrežje).
# TRACCAR_SERVICE_EMAIL/PASSWORD: prijava obstoječega Traccar uporabnika, ki ga app uporablja
# za klice na Traccar REST API (ustvarjanje/branje naprav in pozicij). Ta uporabnik NI
# samodejno ustvarjen — ustvari ga ročno v Traccarjevem spletnem vmesniku ob prvem zagonu
# (priporočeno: administratorske pravice, glej README).
TRACCAR_API_URL=http://localhost:8082
TRACCAR_SERVICE_EMAIL=
TRACCAR_SERVICE_PASSWORD=

# --- Javni URL aplikacije ---
# Trenutno ni uporabljeno nikjer v kodi (rezervirano za morebitno prihodnjo rabo — npr. povezave
# v e-poštnih sporočilih). Varno pusti privzeto vrednost ali nastavi na dejanski URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Začetni sudo uporabnik (prisma/seed.ts, poganja se ročno z `npm run db:seed`) ---
# Če uporabnik s tem e-poštnim naslovom še ne obstaja, ga skript ustvari z vsemi pravicami
# (canManagePlatform itd.). Geslo se generira naključno in izpiše SAMO v konzolo ob zagonu
# skripta — ni nikjer drugje shranjeno, zato si ga takoj zapiši.
SEED_ADMIN_EMAIL=admin@example.com

# --- E-poštna obvestila (neobvezno) ---
# lib/mail.ts. Če SMTP_HOST ni nastavljen, funkcija za pošiljanje e-pošte (npr. samodejno
# generirano geslo ob ustvarjanju uporabnika) preprosto ni na voljo — geslo se namesto tega
# prikaže neposredno administratorju v vmesniku. Brez teh spremenljivk deluje vse ostalo
# normalno.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
