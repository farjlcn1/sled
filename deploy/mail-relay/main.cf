# Postfix -- odhodni rele za sled/teren + minimalno sprejemanje za NASLOV POSILJATELJA
# (obvestila@farjolcn.com), ker nekateri prejemniki (npr. mx1.mega-m.net, ki gosti sledenje.com)
# pred sprejemom poste NAZAJ preverijo (t.i. "sender callback verification"), ali ta naslov sploh
# obstaja -- brez tega korak spodaj zavrnejo z "550 Sender verification failed". Namescen na
# /etc/postfix/main.cf (glej setup.sh).
#
# Aplikacije (Docker vsebniki) se povezejo prek host.docker.internal:25 (glej docker-compose.yml
# extra_hosts), Postfix pa iz tega gostitelja dostavi neposredno na MX prejemnika (Gmail, Outlook ...).

myhostname = mail.farjolcn.com
mydomain = farjolcn.com
myorigin = $mydomain
# "all" (ne samo loopback/docker0) -- zdaj NUJNO, da lahko od zunaj (internet) sploh pride do
# zgornje verifikacije naslova posiljatelja. Varno je, ker spodaj sprejemamo SAMO EN naslov
# (obvestila@farjolcn.com, glej local_recipient_maps) in ga takoj zavržemo (transport_maps:
# discard) -- ni pravega predala, ni mozno uporabiti kot odprt relay (glej
# smtpd_relay_restrictions/smtpd_recipient_restrictions spodaj, nespremenjeno).
inet_interfaces = all
inet_protocols = ipv4
compatibility_level = 3

# Edina "lokalna" domena/naslov je natanko ta en sink za sender-verifikacijo -- vse ostalo (tudi
# druge naslove @farjolcn.com) Postfix zavrne kot "user unknown", ne sprejme na slepo.
mydestination = farjolcn.com
local_recipient_maps = hash:/etc/postfix/local_valid_recipient
transport_maps = hash:/etc/postfix/transport
alias_maps =
alias_database =

# Zaupamo SAMO temu gostitelju in Dockerjevim internim omrezjem (sled_default 172.19.0.0/16,
# teren_default 172.18.0.0/16, oboje znotraj 172.16.0.0/12) -- karkoli drugega je zavrnjeno,
# da to nikoli ne postane odprt relay.
mynetworks_style = subnet
mynetworks = 127.0.0.0/8, 172.16.0.0/12
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_banner = $myhostname ESMTP

# Opportunistic TLS (STARTTLS) -- samo-podpisan certifikat kot izhodisce; ce se kasneje uredi
# javno dostopen mail.farjolcn.com, ga je smiselno zamenjati z Let's Encrypt (ni nujno za
# delovanje, samo za "pravi" certifikat namesto samo-podpisanega).
smtpd_tls_cert_file = /etc/postfix/mail.farjolcn.com.crt
smtpd_tls_key_file = /etc/postfix/mail.farjolcn.com.key
smtpd_tls_security_level = may
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtpd_tls_loglevel = 1

# DKIM podpisovanje prek OpenDKIM (glej opendkim.conf) -- tempfail (namesto accept), ce
# OpenDKIM ne odgovori, da nikoli ne posljemo NEpodpisane poste po pomoti.
milter_default_action = tempfail
milter_protocol = 6
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891

# Umirjen tempo navzven -- nov posiljatelj brez zgodovine naj posilja postopoma, ne v sunkih
# (prejemniki sunkovito pošiljanje pogosteje ocenijo kot spam/bot vzorec).
default_destination_rate_delay = 1s
smtp_destination_rate_delay = 1s
default_destination_concurrency_limit = 5
